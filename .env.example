# ── Turkish Airlines API ───────────────────────────────────────────────────────
TA_API_KEY=
TA_API_BASE=https://api.turkishairlines.com
TA_RATE_LIMIT_PER_MIN=50

# ── Database ───────────────────────────────────────────────────────────────────
# Docker: set POSTGRES_PASSWORD, DATABASE_URL is built automatically in compose
POSTGRES_PASSWORD=change_me
# Neon/Supabase (Vercel deploy): set full URL directly
DATABASE_URL=postgresql://fth:change_me@postgres:5432/faretickethunter

# ── Telegram ───────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Random string — set same value in BotFather webhook secret
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram chat IDs allowed to interact with bot
TELEGRAM_ALLOWED_CHAT_IDS=

# ── Web UI auth ────────────────────────────────────────────────────────────────
# Generate: node -e "const b=require('bcryptjs');b.hash('yourpassword',12).then(console.log)"
AUTH_PASSWORD_HASH=
# Random 32+ char string for session JWT signing
AUTH_SESSION_SECRET=

# ── Scheduling ─────────────────────────────────────────────────────────────────
# Header secret for POST /api/cron/fetch — must match in Vercel Cron config too
CRON_SECRET=
# node-cron expression (Docker only; Vercel uses vercel.json)
CRON_SCHEDULE=0 */12 * * *

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
